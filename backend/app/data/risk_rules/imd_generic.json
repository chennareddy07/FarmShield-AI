{
  "ruleset_id": "imd_generic",
  "rule_version": "0.1.0",
  "rules": [
    {
      "rule_id": "IMD-RAIN-HEAVY",
      "crop_id": "*",
      "growth_stage_ids": ["*"],
      "risk_category": "rainfall",
      "weather_variable": "precipitation_sum_mm",
      "comparison_operator": "between",
      "threshold": 64.5,
      "threshold_upper": 115.6,
      "threshold_unit": "mm",
      "duration_or_window": {"type": "daily", "days": 7},
      "source_time_window": "24-hour IMD observation ending at 08:30 IST",
      "weather_input_time_window": "Open-Meteo local calendar-day precipitation total",
      "window_alignment_verified": false,
      "severity": "moderate",
      "source_reference": {"title": "IMD Press Release No. 11 dated 18 September 2024 (rainfall amount classes)", "publisher": "India Meteorological Department", "url": "https://rsmcnewdelhi.imd.gov.in/uploads/archive/21/21_e66343_PRESS%20RELEASE%2011%20dated%2018th%20%20September%202024.pdf", "publication_date": "2024-09-18"},
      "source_excerpt": "IMD rainfall amount classes (24 h): Heavy rain 64.5-115.5 mm.",
      "effective_from": "2026-01-01",
      "review_status": "needs_review",
      "rule_version": "0.1.0",
      "recommended_action": {"kind": "general", "en_key": "action_general"},
      "notes": "The IMD amount class itself is source-supported, but this operational rule is disabled. IMD's 24-hour observation interval ending at 08:30 IST is not aligned with Open-Meteo's local-calendar-day total. The severity mapping is also a FarmShield design choice, not a crop-specific validated impact."
    },
    {
      "rule_id": "IMD-RAIN-VERYHEAVY",
